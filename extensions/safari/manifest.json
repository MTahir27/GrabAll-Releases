{
  "manifest_version": 3,
  "name": "GrabAll Download Manager",
  "version": "1.0.20",
  "description": "Send Safari downloads, videos, and links straight to GrabAll on macOS.",
  "permissions": [
    "downloads",
    "contextMenus",
    "storage",
    "nativeMessaging",
    "activeTab"
  ],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "GrabAll"
  }
}
